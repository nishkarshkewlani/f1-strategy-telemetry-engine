# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
env/
venv/
ENV/

# Environment Variables
.env

# Data Files & Storage (keep large files out of Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/sample/*
!data/sample/.gitkeep

# DB tracked via Git LFS — do NOT ignore
# *.db  ← removed so f1_engine.db is committed via LFS

# Model Artifacts — commit these (small files, needed for live demo)
# artifacts/*.joblib  ← removed so .joblib files are committed

# IDEs & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit secrets (never commit real secrets)
.streamlit/secrets.toml
