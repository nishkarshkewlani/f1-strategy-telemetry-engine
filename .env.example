# F1 Strategy & Telemetry Engine Configuration

# Database Configuration (SQLite default; PostgreSQL optional for production)
DATABASE_URL=sqlite:///f1_engine.db

# OpenF1 API Base URL
OPENF1_BASE_URL=https://api.openf1.org/v1

# Jolpica API Base URL (optional supplementary data)
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Ingestion Settings
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=4
BACKOFF_FACTOR=1.5
TELEMETRY_DRIVER_LIMIT=2

# Environment Mode: development / production / testing
APP_ENV=development
